{
  "name": "lista-de-tareas",
  "version": "1.0.0",
  "description": "Lista de tareas sencilla (HTML + CSS + JS + Node) creada para practicar pruebas de software.",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test",
    "test:unit": "node --test test/unit.test.js",
    "test:integration": "node --test test/integration.test.js",
    "test:functional": "node --test test/functional.test.js",
    "test:regression": "node --test test/regression.test.js",
    "test:coverage": "node --test --experimental-test-coverage"
  },
  "engines": {
    "node": ">=20"
  }
}
